 import jax.numpy as jnp
 import chex
 
+from .frontier_activity import coefficient_activity_score
+
+
+# ---- Coefficient-activity (curriculum-MaxRL Frontier) configuration --------
+# Promoted from the v3 PLR-runner sidecar into the shared UED score path so
+# every runner -- PLR, ACCEL (PLRRunner + mutations), and PAIRED -- uses one
+# implementation. These are static Python values baked in at trace time, so
+# they must be set before the first jitted score call; runners do so at init.
+_CA = {
+	'n_rollouts': 8,
+	'prior_alpha': 1.0,
+	'prior_beta': 1.0,
+	'posterior_mode': 'expected_activity',
+	'success_threshold': 0.0,
+}
+
+
+def set_coefficient_activity_params(
+		n_rollouts=8,
+		prior_alpha=1.0,
+		prior_beta=1.0,
+		posterior_mode='expected_activity',
+		success_threshold=0.0):
+	"""Configure the coefficient-activity score before any jitted score call."""
+	if n_rollouts < 2:
+		raise ValueError('coefficient activity requires n_rollouts >= 2.')
+	if prior_alpha <= 0 or prior_beta <= 0:
+		raise ValueError('Beta prior parameters must be positive.')
+	if posterior_mode not in ('expected_activity', 'mean_plugin'):
+		raise ValueError(f'Unknown posterior mode {posterior_mode!r}.')
+	_CA.update(
+		n_rollouts=int(n_rollouts),
+		prior_alpha=float(prior_alpha),
+		prior_beta=float(prior_beta),
+		posterior_mode=str(posterior_mode),
+		success_threshold=float(success_threshold))
+
+
+def get_coefficient_activity_params():
+	return dict(_CA)
+
+
+def compute_coefficient_activity(batch):
+	"""Score levels by expected coefficient activity E[u_N(p)].
+
+	Operates on the per-agent batch already reshaped to
+	``(n_steps, n_levels, n_eval)`` by ``compute_ued_scores``. Each evaluation
+	stream contributes at most one Bernoulli observation, matching the v3
+	sidecar semantics: a stream is observed if any ``done`` occurs and
+	successful if any terminal reward exceeds the threshold.
+	"""
+	dones = batch.dones.astype(jnp.bool_)
+	rewards = batch.rewards
+	observed = dones.any(axis=0)
+	successful = jnp.logical_and(dones, rewards > _CA['success_threshold']).any(axis=0)
+	trials = observed.sum(axis=-1)
+	successes = successful.sum(axis=-1)
+	scores = coefficient_activity_score(
+		successes,
+		trials,
+		_CA['n_rollouts'],
+		_CA['prior_alpha'],
+		_CA['prior_beta'],
+		_CA['posterior_mode'])
+	# The generic aggregation path expects a (mean, max) pair; activity is a
+	# single per-level quantity, so both slots carry it.
+	return scores, scores, {}
+
 
