\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The estimator is the curriculum.} \emph  {Left:} the derived utility $u_N(p) = (1-(1-p)^N)-p$ --- half the estimator's expected coefficient mass $A_N = 2u_N$ (Prop.\nobreakspace  {}\ref  {prop:mass}) --- for growing rollout budgets $N$. The peak $p^*\approx \qopname  \relax o{ln}N/N$ walks toward harder prompts as compute grows; the utility vanishes exactly at $p\in \{0,1\}$. \emph  {Right:} all three curves are exact expected half-mass at $N{=}16$ for the estimators \emph  {as deployed} (GRPO with sample-SD normalization: $\sqrt  {\genfrac  {}{}{}1{N-1}{N}}\,\frac  {1}{N}\mathbb  {E}\sqrt  {K(N{-}K)}$, $K\sim \mathrm  {Bin}(N,p)$; MC-verified against the code). MaxRL concentrates $\to (N{-}1)\times $ more mass than RLOO on frontier prompts (Prop.\nobreakspace  {}\ref  {prop:ratio}); in the mastered tail MaxRL and RLOO decay together at first order (both $\to q = 1-p$; MC artifact \texttt  {verify\_guidance\_math.json}) while GRPO's variance normalization keeps ${\sim }(N{-}1)/\sqrt  {N}\times $ their relative mass there --- the maintenance-of-easy-tasks its curriculum arms lose in \S  \ref  {sec:experiments}. RLOO's profile is exactly the published ``learnability'' objective --- the $N{=}2$ slice.}}{3}{figure.7}\protected@file@percent }
\newlabel{fig:utility}{{1}{3}{\textbf {The estimator is the curriculum.} \emph {Left:} the derived utility $u_N(p) = (1-(1-p)^N)-p$ --- half the estimator's expected coefficient mass $A_N = 2u_N$ (Prop.~\ref {prop:mass}) --- for growing rollout budgets $N$. The peak $p^*\approx \ln N/N$ walks toward harder prompts as compute grows; the utility vanishes exactly at $p\in \{0,1\}$. \emph {Right:} all three curves are exact expected half-mass at $N{=}16$ for the estimators \emph {as deployed} (GRPO with sample-SD normalization: $\sqrt {\tfrac {N-1}{N}}\,\frac {1}{N}\mathbb {E}\sqrt {K(N{-}K)}$, $K\sim \mathrm {Bin}(N,p)$; MC-verified against the code). MaxRL concentrates $\to (N{-}1)\times $ more mass than RLOO on frontier prompts (Prop.~\ref {prop:ratio}); in the mastered tail MaxRL and RLOO decay together at first order (both $\to q = 1-p$; MC artifact \texttt {verify\_guidance\_math.json}) while GRPO's variance normalization keeps ${\sim }(N{-}1)/\sqrt {N}\times $ their relative mass there --- the maintenance-of-easy-tasks its curriculum arms lose in \S \ref {sec:experiments}. RLOO's profile is exactly the published ``learnability'' objective --- the $N{=}2$ slice}{figure.7}{}}
