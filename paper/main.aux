\@writefile{toc}{\contentsline {paragraph}{6.4 Where and when does GRPO's coverage go? (level-resolved; cohort data --- read with \S  6.3b's retraction).}{10}{section*.47}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Where and when GRPO's coverage goes (maze, level-resolved, matched wall-clock).} \emph  {(a)} $\Delta \text  {pass@}8$ (final $-$ warmstart) by difficulty band: GRPO's loss lives on the easy/mid band (all 4 runs; dots are runs) while its $\text  {pass@}1$ there rises --- sharpening; MaxRL holds the easy band and gains on the frontier band (18 runs; a heterogeneous run inventory --- descriptive, no $p$-value). \emph  {(b)} Coverage--reliability gap $\overline  {\text  {pass@}8-\text  {pass@}1}$ vs.\ wall-clock (mean and min--max across runs): GRPO's erosion begins within the first ${\sim }25$--$50$ steps, before any level saturates; MaxRL stabilizes after warmup.}}{11}{figure.49}\protected@file@percent }
\newlabel{fig:bands}{{5}{11}{\textbf {Where and when GRPO's coverage goes (maze, level-resolved, matched wall-clock).} \emph {(a)} $\Delta \passat {8}$ (final $-$ warmstart) by difficulty band: GRPO's loss lives on the easy/mid band (all 4 runs; dots are runs) while its $\passat {1}$ there rises --- sharpening; MaxRL holds the easy band and gains on the frontier band (18 runs; a heterogeneous run inventory --- descriptive, no $p$-value). \emph {(b)} Coverage--reliability gap $\overline {\passat {8}-\passat {1}}$ vs.\ wall-clock (mean and min--max across runs): GRPO's erosion begins within the first ${\sim }25$--$50$ steps, before any level saturates; MaxRL stabilizes after warmup}{figure.49}{}}
\@writefile{toc}{\contentsline {paragraph}{6.5--6.6 Two boundary rungs (compressed; full protocols, figures, and attribution in App.\nobreakspace  {}\ref  {app:rungs}).}{11}{section*.50}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6.7 Does it transfer to LLM scale? (GSM8K $2{\times }2$, pre-registered; SmolLM2-360M, $N{=}16$, one A10G).}{11}{section*.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {GSM8K $2{\times }2$, val mean@4 over training.} Both GRPO seeds shown as paired trajectories (registered seed thick, replication thin); gray bar: repeated-eval noise floor of one fixed checkpoint ($\pm $SD .0094), drawn once as a scale. On the registered run GRPO+teacher is the only cell that regresses in its second half; the replication seed climbs instead. \S  6.7 gives the statistics and the steering telemetry that separates the two seeds.}}{12}{figure.52}\protected@file@percent }
\newlabel{fig:gsm8k}{{6}{12}{\textbf {GSM8K $2{\times }2$, val mean@4 over training.} Both GRPO seeds shown as paired trajectories (registered seed thick, replication thin); gray bar: repeated-eval noise floor of one fixed checkpoint ($\pm $SD .0094), drawn once as a scale. On the registered run GRPO+teacher is the only cell that regresses in its second half; the replication seed climbs instead. \S 6.7 gives the statistics and the steering telemetry that separates the two seeds}{figure.52}{}}
\@writefile{toc}{\contentsline {paragraph}{6.8 What does recycling cost? (Countdown $2{\times }2$, pre-registered): two nulls and a new phenomenon.}{12}{section*.57}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Recycling-induced sharpening and its saturation-gate mitigation (Countdown, tier 1).} \emph  {(a)} Three seeds, both axes: recycling (B2) buys mean@16 with $\text  {pass@}16$ coverage; the moderate gate (B3) gives most of the mean back on this early-saturating tier. The pre-registered designed-strength arm (diamonds; 3 seeds, corrected decay, rejection ${\sim }.94$) refuted the strength-dial reading: its seeds scatter around the no-recycling point rather than extending a frontier (P-R1, \S  6.9), so it is drawn as a scatter per the committed falsification branch; the superseded 1-seed point (faint) sits inside that spread. \emph  {(b)} The mechanism in-run: the gate's rejection rate rises monotonically as the model's reachable set saturates its relabel destinations, while the ungated dose rides its cap. \emph  {(c)} Gated recycling preserves \emph  {more} policy entropy than no recycling --- admitted relabels are a spread-preserving gradient.}}{13}{figure.56}\protected@file@percent }
\newlabel{fig:sharpening}{{7}{13}{\textbf {Recycling-induced sharpening and its saturation-gate mitigation (Countdown, tier 1).} \emph {(a)} Three seeds, both axes: recycling (B2) buys mean@16 with $\passat {16}$ coverage; the moderate gate (B3) gives most of the mean back on this early-saturating tier. The pre-registered designed-strength arm (diamonds; 3 seeds, corrected decay, rejection ${\sim }.94$) refuted the strength-dial reading: its seeds scatter around the no-recycling point rather than extending a frontier (P-R1, \S 6.9), so it is drawn as a scatter per the committed falsification branch; the superseded 1-seed point (faint) sits inside that spread. \emph {(b)} The mechanism in-run: the gate's rejection rate rises monotonically as the model's reachable set saturates its relabel destinations, while the ungated dose rides its cap. \emph {(c)} Gated recycling preserves \emph {more} policy entropy than no recycling --- admitted relabels are a spread-preserving gradient}{figure.56}{}}
\@writefile{toc}{\contentsline {paragraph}{6.9 Does the gate recover it? (Countdown v2 pool, 3 seeds, pre-registered).}{13}{section*.58}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Sharpening is a crossing in $k$ (Countdown tier 1, step-60 val, seed 1; unbiased pass@$k$ from 16 samples, $n{=}128$).} Ungated recycling sits above baseline at $k{=}1$ (mean up) and below by $k{=}4$ (coverage down), the deficit widening with $k$. The moderate gate tracks baseline at low $k$ with a smaller high-$k$ deficit; the full-strength curve (hollow; one seed, corrected decay) pays at $k{=}1$ and finishes above baseline at $k{=}16$, but the strength-dial reading this suggests was refuted in the 3-seed designed-strength sweep (P-R1, \S  6.9). Endpoints cross-check the 3-seed scoreboard; per-$k$ telemetry from the seed-1 logs.}}{14}{figure.61}\protected@file@percent }
\newlabel{fig:passk}{{8}{14}{\textbf {Sharpening is a crossing in $k$ (Countdown tier 1, step-60 val, seed 1; unbiased pass@$k$ from 16 samples, $n{=}128$).} Ungated recycling sits above baseline at $k{=}1$ (mean up) and below by $k{=}4$ (coverage down), the deficit widening with $k$. The moderate gate tracks baseline at low $k$ with a smaller high-$k$ deficit; the full-strength curve (hollow; one seed, corrected decay) pays at $k{=}1$ and finishes above baseline at $k{=}16$, but the strength-dial reading this suggests was refuted in the 3-seed designed-strength sweep (P-R1, \S 6.9). Endpoints cross-check the 3-seed scoreboard; per-$k$ telemetry from the seed-1 logs}{figure.61}{}}
