\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The estimator is the curriculum.} \emph  {Left:} the derived utility $u_N(p) = (1-(1-p)^N)-p$ --- the estimator's expected advantage mass (Prop.\nobreakspace  {}\ref  {prop:mass}) --- for growing rollout budgets $N$. The peak $p^*\approx \qopname  \relax o{ln}N/N$ walks toward harder prompts as compute grows; both tails are dead zones the weight function cannot reach. \emph  {Right:} all three curves are exact expected mass at $N{=}16$ (GRPO's is $\frac  {1}{N}\mathbb  {E}\sqrt  {K(N{-}K)}$, $K\sim \mathrm  {Bin}(N,p)$; MC-verified). MaxRL concentrates $\to (N{-}1)\times $ more mass than RLOO on frontier prompts (Prop.\nobreakspace  {}\ref  {prop:ratio}) and releases mastered prompts fastest; GRPO's variance normalization keeps $\sim \sqrt  {N{-}1}\times $ MaxRL's relative mass on mastered prompts --- the maintenance-of-easy-tasks its curriculum arms lose in \S  \ref  {sec:experiments}. RLOO's profile is exactly the published ``learnability'' objective --- the $N{=}2$ slice.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:utility}{{1}{3}{\textbf {The estimator is the curriculum.} \emph {Left:} the derived utility $u_N(p) = (1-(1-p)^N)-p$ --- the estimator's expected advantage mass (Prop.~\ref {prop:mass}) --- for growing rollout budgets $N$. The peak $p^*\approx \ln N/N$ walks toward harder prompts as compute grows; both tails are dead zones the weight function cannot reach. \emph {Right:} all three curves are exact expected mass at $N{=}16$ (GRPO's is $\frac {1}{N}\mathbb {E}\sqrt {K(N{-}K)}$, $K\sim \mathrm {Bin}(N,p)$; MC-verified). MaxRL concentrates $\to (N{-}1)\times $ more mass than RLOO on frontier prompts (Prop.~\ref {prop:ratio}) and releases mastered prompts fastest; GRPO's variance normalization keeps $\sim \sqrt {N{-}1}\times $ MaxRL's relative mass on mastered prompts --- the maintenance-of-easy-tasks its curriculum arms lose in \S \ref {sec:experiments}. RLOO's profile is exactly the published ``learnability'' objective --- the $N{=}2$ slice}{figure.1}{}}
