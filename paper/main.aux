\@writefile{toc}{\contentsline {paragraph}{7.1 Exact-gradient skill chains (CPU, 5 seeds).}{6}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{7.2 Frontier-heavy regime (max pool pass rate $10^{-5}$).}{6}{section*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The ladder.} (a) Exact-gradient chains: a floor-and-$\gamma $-matched true-pass-rate oracle \emph  {ties} the full stack --- allocation saturates --- and recycling still adds on top of the oracle. (b) Frontier-heavy regime: allocation scores exactly zero; creation solves it. (c) Maze at matched wall-clock: 6/6 paired seed wins. (d) GSM8K $2{\times }2$ (complete): GRPO+teacher is the only cell that regresses (pre-registered P-G2); the teacher's MaxRL effect is a null at this budget (P-G1).}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:ladder}{{4}{7}{\textbf {The ladder.} (a) Exact-gradient chains: a floor-and-$\gamma $-matched true-pass-rate oracle \emph {ties} the full stack --- allocation saturates --- and recycling still adds on top of the oracle. (b) Frontier-heavy regime: allocation scores exactly zero; creation solves it. (c) Maze at matched wall-clock: 6/6 paired seed wins. (d) GSM8K $2{\times }2$ (complete): GRPO+teacher is the only cell that regresses (pre-registered P-G2); the teacher's MaxRL effect is a null at this budget (P-G1)}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{7.3 Maze transformer at matched wall-clock (1.26M params, 13 levels, ${\sim }30$ runs, 3 seeds).}{7}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{7.4a Legged locomotion (IsaacLab, pre-registered honest null).}{7}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{7.4b Gymnasium control (MountainCar, CartPole) --- trained to convergence, official-task currency.}{7}{section*.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Gym control, trained to plateau (3 seeds, matched episodes).} Solid: mean pass rate across curriculum bins; dashed: the \emph  {official} task (MountainCar flag / CartPole survive-400). Standard RL flatlines at zero on the official task; a uniform-over-bins control (green) also cracks it --- slower and off-ceiling --- isolating what the teacher adds (speed, seed-stability) from what task spread adds (existence of the gradient); the gated FrontierMax stack converges to $1.000{\pm }0.000$.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:gym}{{5}{8}{\textbf {Gym control, trained to plateau (3 seeds, matched episodes).} Solid: mean pass rate across curriculum bins; dashed: the \emph {official} task (MountainCar flag / CartPole survive-400). Standard RL flatlines at zero on the official task; a uniform-over-bins control (green) also cracks it --- slower and off-ceiling --- isolating what the teacher adds (speed, seed-stability) from what task spread adds (existence of the gradient); the gated FrontierMax stack converges to $1.000{\pm }0.000$}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{7.5 LLM scale: GSM8K $2{\times }2$, pre-registered (SmolLM2-360M, $N{=}16$, one A10G).}{8}{section*.6}\protected@file@percent }
