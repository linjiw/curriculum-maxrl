<?xml version="1.0"?>
<!--
  Generic Jackal-footprint differential-drive robot for the frozen BARN CPU
  campaign.  All sensors and plugins are CPU Gazebo Classic / ROS 2 plugins.
  The policy consumes /scan and publishes /cmd_vel; /odom and /bumper_states
  are used only by the outcome verifier and trajectory logger.
-->
<sdf version="1.6">
  <model name="barn_robot">
    <pose>0 0 0 0 0 0</pose>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_footprint"/>
    <link name="base_link">
      <inertial>
        <mass>17.0</mass>
        <inertia>
          <ixx>0.34</ixx><iyy>0.42</iyy><izz>0.62</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.508 0.430 0.20</size></box></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.508 0.430 0.20</size></box></geometry>
        <material><ambient>0.15 0.25 0.55 1</ambient></material>
      </visual>
      <sensor type="contact" name="base_bumper">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>base_collision</collision></contact>
        <plugin name="barn_bumper" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=bumper_states</remapping></ros>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="left_wheel">
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0.205 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.04</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>100</mu><mu2>100</mu2><fdir1>1 0 0</fdir1></ode></friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <pose>0 0.205 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 -0.205 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.04</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>100</mu><mu2>100</mu2><fdir1>1 0 0</fdir1></ode></friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <pose>0 -0.205 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.085</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>

    <link name="rear_caster">
      <pose>-0.19 0 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="rear_caster_collision">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="lidar_link">
      <pose>0.12 0 0.28 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="cpu_lidar" type="ray">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan><horizontal>
            <samples>180</samples><resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle>
          </horizontal></scan>
          <range><min>0.08</min><max>6.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="barn_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent><child>base_link</child>
    </joint>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent><child>rear_caster</child>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <plugin name="barn_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>20</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.410</wheel_separation>
      <wheel_diameter>0.170</wheel_diameter>
      <max_wheel_torque>80</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </model>
</sdf>
